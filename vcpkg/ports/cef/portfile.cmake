if("static-engine" IN_LIST FEATURES)
    message(FATAL_ERROR "A fully static CEF engine is NOT implemented or validated by this port. The default package is a static C++ wrapper PLUS a mandatory shared libcef runtime. See vcpkg/STATIC-ANALYSIS.md.")
endif()
vcpkg_check_linkage(ONLY_STATIC_LIBRARY)
if(NOT VCPKG_TARGET_ARCHITECTURE STREQUAL "x64")
    message(FATAL_ERROR "Only native Windows/Linux x64 builds are supported.")
endif()
set(CEF_VERSION_FULL "152.0.6+g708dc14+chromium-152.0.7977.83")
if(VCPKG_TARGET_IS_WINDOWS)
    set(platform windows64)
    set(archive_sha512 a3f74a522c2a9ed855bd291435e239012f1647992ee2054f157eda6f02c98fc764128370a4e8198fb9e1db2a9762cdc66eda6b2ec4d02d12cf1b565507b2ae18)
elseif(VCPKG_TARGET_IS_LINUX)
    set(platform linux64)
    set(archive_sha512 d37812c474c5368baac566646d30618026fda809f759c302ab72c5e462e7298b63ed64ab431057f2bb5e6dd284c3e2bc05a3a5c2318d0e82804a5019061c6fc2)
else()
    message(FATAL_ERROR "Only Windows and Linux are supported.")
endif()
message(STATUS "CEF linkage: wrapper=STATIC; Chromium engine=SHARED; official Release runtime is used with both wrapper configurations.")
set(filename "cef_binary_${CEF_VERSION_FULL}_${platform}_minimal.tar.bz2")
vcpkg_download_distfile(archive
    URLS "https://cef-builds.spotifycdn.com/${filename}"
    FILENAME "${filename}"
    SHA512 "${archive_sha512}"
)
vcpkg_extract_source_archive(SOURCE_PATH ARCHIVE "${archive}")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/CMakeLists.txt" "${CMAKE_CURRENT_LIST_DIR}/cef-config.cmake.in" "${CMAKE_CURRENT_LIST_DIR}/cef-deploy.cmake" DESTINATION "${SOURCE_PATH}")
vcpkg_cmake_configure(SOURCE_PATH "${SOURCE_PATH}")
vcpkg_cmake_install()
vcpkg_cmake_config_fixup(PACKAGE_NAME cef CONFIG_PATH lib/cmake/cef)
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug/include" "${CURRENT_PACKAGES_DIR}/debug/share" "${CURRENT_PACKAGES_DIR}/debug/tools")
vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/LICENSE.txt")
file(INSTALL "${CMAKE_CURRENT_LIST_DIR}/usage" DESTINATION "${CURRENT_PACKAGES_DIR}/share/cef")
